# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Secrets / local env
.env
.env.*
!.env.example

# Local rollback snapshots / scratch (not source of truth)
.local/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Alembic (keep versions tracked; ignore local junk if any)
*.db

# Runtime media
media/

# Uploads
uploads/

