POSTGRES_USER=aivai
POSTGRES_PASSWORD=aivai_secret  # development-only placeholder
POSTGRES_DB=aivai
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432

JWT_SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

MEDIA_ROOT=media
MEDIA_URL=/media/
MEDIA_STORAGE_BACKEND=local  # local | s3

# S3-compatible (AWS S3 / Cloudflare R2 / MinIO) — required when MEDIA_STORAGE_BACKEND=s3
# MEDIA_S3_ENDPOINT_URL=https://xxxx.r2.cloudflarestorage.com
# MEDIA_S3_BUCKET=aivai-media
# MEDIA_S3_REGION=auto
# MEDIA_S3_ACCESS_KEY=
# MEDIA_S3_SECRET_KEY=
# MEDIA_S3_PUBLIC_BASE_URL=https://media.example.com/
# MEDIA_S3_ADDRESSING_STYLE=path

# Media async pipeline (Stage 3) — default OFF; sync upload unchanged
# MEDIA_ASYNC_PIPELINE_ENABLED=false
# MEDIA_ASYNC_PIPELINE_VERSION=v2
# MEDIA_DIRECT_UPLOAD_ENABLED=false
# MEDIA_CDN_BASE_URL=https://media.example.com/
# MEDIA_ORIGINAL_PUBLIC=false
# MEDIA_PRESIGN_TTL_SECONDS=900
# MEDIA_UPLOAD_RESERVATION_TTL_SECONDS=3600
# MEDIA_DETECTOR_INFERENCE_MAX_EDGE=1280
# MEDIA_ENGINE_JPEG_QUALITY=88
# MEDIA_QUEUE_NAMESPACE=aivai:media
# MEDIA_JOB_LEASE_SECONDS=300
# MEDIA_JOB_MAX_ATTEMPTS=5
# MEDIA_JOB_RETRY_BACKOFF_SECONDS=15,60,300,900,3600
# MEDIA_WORKER_MIN_REPLICAS=1
# MEDIA_WORKER_MAX_REPLICAS=10

OPENAI_API_KEY=  # optional; Whisper STT (/api/v1/voice/audio); empty — 502 on audio endpoint

TTS_AUDIO_TTL_HOURS=24  # TTL для media/tts/*.mp3; очистка: python -m scripts.cleanup_tts_audio

ASSISTANT_CONVERSATION_TTL_DAYS=7  # диалоги без активности; автоочистка при работе API
ASSISTANT_CONVERSATION_CLEANUP_ENABLED=true
ASSISTANT_CONVERSATION_CLEANUP_INTERVAL_HOURS=24
ASSISTANT_CONVERSATION_CLEANUP_BATCH_SIZE=2000
ASSISTANT_CONVERSATION_CLEANUP_MAX_BATCHES=500
ASSISTANT_CONVERSATION_CLEANUP_BATCH_PAUSE_MS=50

CATEGORY_SNAPSHOT_TTL_SECONDS=60  # in-process cache for category routing/moderation snapshot

# LOG_LEVEL=INFO
# LOG_JSON=0
