POSTGRES_USER=aivai
POSTGRES_PASSWORD=aivai_secret  # development-only placeholder
POSTGRES_DB=aivai
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432

JWT_SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

MEDIA_ROOT=media
MEDIA_URL=/media/

OPENAI_API_KEY=  # optional; Whisper STT (/api/v1/voice/audio); empty — 502 on audio endpoint

TTS_AUDIO_TTL_HOURS=24  # TTL для media/tts/*.mp3; очистка: python -m scripts.cleanup_tts_audio

ASSISTANT_CONVERSATION_TTL_DAYS=7  # диалоги без активности; автоочистка при работе API
ASSISTANT_CONVERSATION_CLEANUP_ENABLED=true
ASSISTANT_CONVERSATION_CLEANUP_INTERVAL_HOURS=24
ASSISTANT_CONVERSATION_CLEANUP_BATCH_SIZE=2000
ASSISTANT_CONVERSATION_CLEANUP_MAX_BATCHES=500
ASSISTANT_CONVERSATION_CLEANUP_BATCH_PAUSE_MS=50

CATEGORY_SNAPSHOT_TTL_SECONDS=60  # in-process cache for category routing/moderation snapshot

# LOG_LEVEL=INFO
# LOG_JSON=0
